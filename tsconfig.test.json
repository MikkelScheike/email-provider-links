{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "examples/**/*",
    "scripts/**/*",
    "test-utils/**/*",
    "vitest.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
