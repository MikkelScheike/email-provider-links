{
  "branches": ["main"],
  "plugins": [
    [
      "./scripts/semantic-release-filter-commits.cjs",
      {
        "pathPrefix": "packages/email-provider-links/"
      }
    ],
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pnpm run update-hashes"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": true,
        "tarballDir": "packages/email-provider-links/dist",
        "pkgRoot": "packages/email-provider-links"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "packages/email-provider-links/package.json",
          "pnpm-lock.yaml",
          "packages/email-provider-links/src/hash-verifier.ts"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    {
      "name": "@semantic-release/github",
      "config": {
        "assets": [
          {
            "path": "packages/email-provider-links/dist/*.tgz",
            "label": "NPM Package"
          }
        ]
      }
    }
  ],
  "preset": "conventionalcommits",
  "releaseRules": [
    {
      "type": "docs",
      "release": "patch"
    },
    {
      "type": "refactor",
      "release": "patch"
    },
    {
      "type": "style",
      "release": "patch"
    },
    {
      "type": "security",
      "release": "patch"
    }
  ]
}
